# .env.example ko copy karke ".env" naam do aur apni keys bharo.
# .env ko kabhi GitHub / kisi ko share mat karna.

# Kaunsa AI use karna hai: groq | openai | gemini
LLM_PROVIDER=groq

GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Optional ---
# LLM_MODEL=                      # default model badalna ho toh
# EXCEL_PATH=data/DataEntry.xlsx
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_LANG=eng                    # Hindi bhi padhni ho: eng+hin
# VOICE_LANG=hi-IN                # English ke liye: en-IN
